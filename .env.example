# ─────────────────────────────────────────────────────────────
# Cloud Brain for Robots — environment configuration
# Copy to `.env` and adjust. Docker Compose reads this file.
# ─────────────────────────────────────────────────────────────

# --- Application ---
ENVIRONMENT=development          # development | staging | production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
API_V1_PREFIX=/api/v1

# --- Security (CHANGE THIS IN PRODUCTION) ---
SECRET_KEY=change-me-to-a-long-random-string

# --- Claude / Anthropic ---
# Leave empty to run the brain in deterministic MOCK mode (no API calls).
ANTHROPIC_API_KEY=
# Optional: route requests through an AI tunnel / proxy (any
# Anthropic-compatible endpoint). Leave empty to call Claude directly.
# Example: https://my-ai-tunnel.example.com
ANTHROPIC_BASE_URL=
# Most capable default. For high-throughput fleets switch to
# claude-sonnet-4-6 or claude-haiku-4-5 (same decision contract).
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_MAX_TOKENS=1024
CLAUDE_THINKING=disabled         # disabled | adaptive

# --- Database (Postgres) ---
DATABASE_URL=postgresql+asyncpg://brain:brain@postgres:5432/brain

# --- Redis ---
REDIS_URL=redis://redis:6379/0
HEARTBEAT_TTL_SECONDS=30

# --- Object storage (MinIO / S3) ---
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=robot-frames

# --- CORS (comma-separated, or * for all) ---
CORS_ORIGINS=*

# --- Frontend / Dashboard ---
# Public URL the browser uses to reach the backend API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
