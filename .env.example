# ─────────────────────────────────────────────────────────────
# Cloud Brain for Robots — environment configuration
# Copy to `.env` and adjust. Docker Compose reads this file.
# ─────────────────────────────────────────────────────────────

# --- Application ---
ENVIRONMENT=development          # development | staging | production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
API_V1_PREFIX=/api/v1

# --- Security (CHANGE THIS IN PRODUCTION) ---
SECRET_KEY=change-me-to-a-long-random-string

# --- Claude / Anthropic ---
# Leave empty to run the brain in deterministic MOCK mode (no API calls).
ANTHROPIC_API_KEY=
# Optional: route requests through an AI tunnel / proxy (any
# Anthropic-compatible endpoint). Leave empty to call Claude directly.
# Example: https://my-ai-tunnel.example.com
ANTHROPIC_BASE_URL=
# Most capable default. For high-throughput fleets switch to
# claude-sonnet-4-6 or claude-haiku-4-5 (same decision contract).
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_MAX_TOKENS=1024
CLAUDE_THINKING=disabled         # disabled | adaptive

# --- Model Router (AI Decision Engine provider) ---
# auto = pick from configured credentials (claude -> openai -> mock).
# Force one with: claude | openai | yandexgpt | gigachat | local | mock
LLM_PROVIDER=auto
# OpenAI / OpenAI-compatible — also used for LOCAL models and the Russian
# engines (YandexGPT, GigaChat) via an OpenAI-compatible gateway
# (e.g. Ollama/vLLM/LM Studio, or a GigaChat/YandexGPT proxy).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# --- Demo mode ---
# Seeds a live "Demo" device so the dashboard is never empty. Disable in
# production with DEMO_MODE=false.
DEMO_MODE=true
DEMO_INTERVAL_SECONDS=5

# --- Database (Postgres) — the only required backing service ---
DATABASE_URL=postgresql+asyncpg://brain:brain@postgres:5432/brain
# A robot is "online" if it heartbeated within this many seconds.
HEARTBEAT_TTL_SECONDS=30

# --- Object storage (S3 / MinIO) — OPTIONAL ---
# Leave empty to run without frame storage (decisions still work). Fill in to
# persist camera frames on any S3-compatible store.
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=robot-frames

# --- Email (SMTP) — OPTIONAL ---
# Set all four to switch email on: login confirmation codes, password/email
# change codes, the welcome email, contact-form receipts and newsletters.
# Leave them empty and the app runs without email (codes skipped, mail logged).
# Port 465 = implicit TLS (SSL); port 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_ENCRYPTION=SSL
SMTP_USER=
SMTP_PASSWORD=

# --- Observability — OPTIONAL ---
# GET /metrics serves the whole installation in Prometheus exposition format:
# request rate and latency, the share of decisions that fell back to the
# deterministic placeholder, fleet and queue sizes. Scrapes authenticate with
# `Authorization: Bearer $METRICS_TOKEN` (Prometheus job option `bearer_token`).
# In production the token is mandatory — without one the endpoint returns 404
# rather than serving fleet data to the internet.
METRICS_ENABLED=true
METRICS_TOKEN=

# Sentry. Leave the DSN empty and the SDK is never initialised. Request bodies,
# cookies and Authorization headers are stripped before anything is sent.
SENTRY_DSN=
# 0 = errors only. Raise temporarily to trace performance.
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_ENVIRONMENT=

# --- CORS (comma-separated, or * for all) ---
CORS_ORIGINS=*

# --- Frontend / Dashboard ---
# Public URL the browser uses to reach the backend API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
