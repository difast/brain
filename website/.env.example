# Public site URL — used for canonical/OG tags, sitemap and robots.
# Set to the deployed Timeweb domain in production.
NEXT_PUBLIC_SITE_URL=https://mevratek.ru

# Backend API base URL used by the contact form (POST {URL}/leads).
# Inlined into the client bundle at BUILD TIME by Next.js — setting it as a
# runtime env var on the platform has no effect. It must reach `npm run build`
# (Dockerfile passes it through as a build ARG; buildpack builds already run
# with the panel's env vars present).
NEXT_PUBLIC_API_BASE_URL=https://api.mevratek.ru/api/v1
